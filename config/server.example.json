{
  "bind_addr": "127.0.0.1:50051",
  "logs_dir": "./sample-maintenanceRuns",
  "requests_dir": "./sample-maintenanceRuns/requests",
  "admin_token_hash": "",
  "allow_insecure_no_auth": false,
  "retention_days": 400,
  "ingest_interval_secs": 30,
  "metrics": {
    "trend_windows_days": [
      7,
      30,
      90,
      365
    ],
    "rollups": [
      "daily",
      "weekly",
      "block4",
      "yearly"
    ]
  },
  "request_timeout_secs": 10800,
  "data_dir": "./.local/itcmdr-data",
  "auth_mode": "both"
}
