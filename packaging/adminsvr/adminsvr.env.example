# itcmdr-adminsvr settings (v0.19.0). Copy to /etc/itcmdr-adminsvr/adminsvr.env (mode 0600).
# Database (adminsvr creates and migrates its tables). Empty = SQLite at
# <data dir>/adminsvr.db, fine for small installs. For Postgres (the database must exist):
#   ITCMDR_ADMINSVR_DB_URL=postgres://itcmdr_adminsvr:CHANGE-ME@127.0.0.1:5432/itcmdr_adminsvr
ITCMDR_ADMINSVR_DB_URL=
ITCMDR_ADMINSVR_DATA_DIR=/var/lib/itcmdr-adminsvr
# Listen addresses: admin API (CLI/app) and SiteLink (sites dial in).
ITCMDR_ADMINSVR_API_ADDR=0.0.0.0:8444
ITCMDR_ADMINSVR_SITE_ADDR=0.0.0.0:8443
# host:port that clients and sites use to reach this server (written into codes and tokens).
ITCMDR_ADMINSVR_PUBLIC_API=
ITCMDR_ADMINSVR_PUBLIC_SITE=
# Extra TLS certificate names, comma separated.
ITCMDR_ADMINSVR_TLS_NAMES=
ITCMDR_ADMINSVR_HEARTBEAT_SECS=60
ITCMDR_ADMINSVR_SITE_MISSED=5
