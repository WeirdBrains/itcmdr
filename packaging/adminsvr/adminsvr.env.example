# itcmdr-adminsvr settings (v0.19.2). Copy to /etc/itcmdr-adminsvr/adminsvr.env (mode 0600).
# Database (adminsvr creates and migrates its tables). Empty = SQLite at
# <data dir>/adminsvr.db, fine for small installs. For Postgres (the database must exist):
#   ITCMDR_ADMINSVR_DB_URL=postgres://itcmdr_adminsvr:CHANGE-ME@127.0.0.1:5432/itcmdr_adminsvr
ITCMDR_ADMINSVR_DB_URL=
ITCMDR_ADMINSVR_DATA_DIR=/var/lib/itcmdr-adminsvr
# Listen addresses: admin API (CLI/app) and SiteLink (sites dial in).
ITCMDR_ADMINSVR_API_ADDR=0.0.0.0:8444
ITCMDR_ADMINSVR_SITE_ADDR=0.0.0.0:8443
# host:port that clients and sites use to reach this server (written into codes and tokens).
ITCMDR_ADMINSVR_PUBLIC_API=
ITCMDR_ADMINSVR_PUBLIC_SITE=
# Extra TLS certificate names, comma separated.
ITCMDR_ADMINSVR_TLS_NAMES=
ITCMDR_ADMINSVR_HEARTBEAT_SECS=60
ITCMDR_ADMINSVR_SITE_MISSED=5
# Passkeys (v0.19.1): WebAuthn RP id (default: the host of PUBLIC_API) and web app origins.
ITCMDR_ADMINSVR_RP_ID=
ITCMDR_ADMINSVR_WEB_ORIGINS=
# Push notifications for alerts (v0.19.2), off unless set. Payloads carry only opaque ids and
# the severity. FCM (Android): the Firebase service account JSON file.
ITCMDR_ADMINSVR_FCM_SERVICE_ACCOUNT=
# APNs (iOS/macOS): the .p8 auth key file, its key id, the team id, the app's bundle id. For
# development builds: ITCMDR_ADMINSVR_APNS_URL=https://api.sandbox.push.apple.com
ITCMDR_ADMINSVR_APNS_KEY=
ITCMDR_ADMINSVR_APNS_KEY_ID=
ITCMDR_ADMINSVR_APNS_TEAM_ID=
ITCMDR_ADMINSVR_APNS_TOPIC=
# Lowest severity that is pushed: critical | cautious | informational
ITCMDR_ADMINSVR_PUSH_MIN_SEVERITY=cautious
